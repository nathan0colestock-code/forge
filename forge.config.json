{
  "$schema": "./forge.config.schema.json",
  "autoDeploy": true,
  "wallClockMin": 0,
  "designLoop": {
    "maxIterations": 5,
    "minVisualScore": 8
  },
  "qualityLoop": {
    "maxIterations": 5,
    "minVisualScore": 8,
    "requireAllTestsPassing": true
  },
  "deployLoop": {
    "maxIterations": 3
  },
  "watcher": {
    "enabled": true,
    "intervalMin": 30,
    "maxConcurrent": 1,
    "maxPerRun": 3
  },
  "viewports": {
    "desktop": { "width": 1280, "height": 800 },
    "mobile":  { "width": 375,  "height": 812 },
    "tablet":  { "width": 768,  "height": 1024 }
  },
  "models": {
    "orchestrator": "claude-opus-4-7",
    "spec":         "claude-opus-4-7",
    "architect":    "claude-opus-4-7",
    "datamodel":    "claude-sonnet-4-6",
    "designer":     "claude-opus-4-7",
    "uiPolish":     "claude-sonnet-4-6",
    "coder":        "claude-sonnet-4-6",
    "tester":       "claude-sonnet-4-6",
    "visualQa":     "claude-opus-4-7",
    "logger":       "claude-haiku-4-5-20251001",
    "infra":        "claude-sonnet-4-6",
    "debug":        "claude-opus-4-7",
    "persona":      "claude-sonnet-4-6"
  }
}
