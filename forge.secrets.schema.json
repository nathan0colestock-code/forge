{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgeSecretsBundle",
  "description": "Zero-touch secrets bundle for Forge apps. Never commit this file — keep it in a vault or pass via FORGE_SECRETS_BUNDLE env var.",
  "type": "object",
  "required": ["version", "turso", "clerk", "betterstack", "fly"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1",
      "description": "Bundle schema version. Always '1'."
    },
    "turso": {
      "type": "object",
      "required": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN"],
      "additionalProperties": false,
      "properties": {
        "TURSO_DATABASE_URL": { "type": "string", "pattern": "^libsql://" },
        "TURSO_AUTH_TOKEN":   { "type": "string", "minLength": 10 }
      }
    },
    "clerk": {
      "type": "object",
      "required": ["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY", "CLERK_SECRET_KEY"],
      "additionalProperties": false,
      "properties": {
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": { "type": "string", "pattern": "^pk_" },
        "CLERK_SECRET_KEY":                 { "type": "string", "pattern": "^sk_" }
      }
    },
    "cloudflare": {
      "description": "Required only if the app uses file storage (R2).",
      "type": "object",
      "required": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_R2_BUCKET_NAME",
        "CLOUDFLARE_R2_ACCESS_KEY_ID",
        "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
        "CLOUDFLARE_R2_ENDPOINT"
      ],
      "additionalProperties": false,
      "properties": {
        "CLOUDFLARE_ACCOUNT_ID":            { "type": "string", "minLength": 1 },
        "CLOUDFLARE_R2_BUCKET_NAME":        { "type": "string", "minLength": 1 },
        "CLOUDFLARE_R2_ACCESS_KEY_ID":      { "type": "string", "minLength": 1 },
        "CLOUDFLARE_R2_SECRET_ACCESS_KEY":  { "type": "string", "minLength": 1 },
        "CLOUDFLARE_R2_ENDPOINT":           { "type": "string", "pattern": "^https://" }
      }
    },
    "resend": {
      "description": "Required only if the app sends email.",
      "type": "object",
      "required": ["RESEND_API_KEY", "RESEND_FROM_EMAIL"],
      "additionalProperties": false,
      "properties": {
        "RESEND_API_KEY":    { "type": "string", "pattern": "^re_" },
        "RESEND_FROM_EMAIL": { "type": "string", "format": "email" }
      }
    },
    "betterstack": {
      "type": "object",
      "required": ["BETTERSTACK_SOURCE_TOKEN", "BETTERSTACK_SOURCE_ID", "BETTERSTACK_API_TOKEN"],
      "additionalProperties": false,
      "properties": {
        "BETTERSTACK_SOURCE_TOKEN": { "type": "string", "minLength": 1 },
        "BETTERSTACK_SOURCE_ID":    { "type": "string", "minLength": 1 },
        "BETTERSTACK_API_TOKEN":    { "type": "string", "minLength": 1 }
      }
    },
    "fly": {
      "type": "object",
      "required": ["FLY_APP_NAME", "FLY_API_TOKEN"],
      "additionalProperties": false,
      "properties": {
        "FLY_APP_NAME":  { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "FLY_API_TOKEN": { "type": "string", "minLength": 10 }
      }
    },
    "app": {
      "description": "Optional app-level overrides. Defaults are inferred from the Fly app name.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NEXT_PUBLIC_APP_URL":  { "type": "string", "pattern": "^https://" },
        "NEXT_PUBLIC_APP_NAME": { "type": "string", "minLength": 1 }
      }
    }
  }
}
