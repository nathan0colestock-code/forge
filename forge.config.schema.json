{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Build Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "autoDeploy": { "type": "boolean", "default": true, "description": "Auto-deploy to Fly.io at end of pipeline" },
    "wallClockMin": { "type": "integer", "minimum": 0, "default": 0, "description": "Wall-clock cap in minutes; 0 = no cap" },
    "designLoop": {
      "type": "object",
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "default": 5 },
        "minVisualScore": { "type": "number", "minimum": 0, "maximum": 10, "default": 8 }
      }
    },
    "qualityLoop": {
      "type": "object",
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "default": 5 },
        "minVisualScore": { "type": "number", "minimum": 0, "maximum": 10, "default": 8 },
        "requireAllTestsPassing": { "type": "boolean", "default": true }
      }
    },
    "deployLoop": {
      "type": "object",
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "watcher": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "intervalMin": { "type": "integer", "minimum": 1, "default": 30 },
        "maxConcurrent": { "type": "integer", "minimum": 1, "default": 1 },
        "maxPerRun": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "logWatcher": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "Whether the log watcher runs at all" },
        "intervalMin": { "type": "integer", "minimum": 1, "default": 60, "description": "How often to invoke; pair with /loop matching this" },
        "lookbackMin": { "type": "integer", "minimum": 1, "default": 60, "description": "How far back to query Better Stack each run" },
        "errorRatePerMin": { "type": "number", "minimum": 0, "default": 1, "description": "Errors/min on a single signature that constitutes a spike" },
        "p95LatencyMs": { "type": "integer", "minimum": 0, "default": 2000, "description": "p95 latency above this on any path = slow-endpoint anomaly" },
        "minOccurrences": { "type": "integer", "minimum": 1, "default": 3, "description": "Minimum hits before a new error class becomes an issue" },
        "postDeployQuietMin": { "type": "integer", "minimum": 0, "default": 30, "description": "Suppress filing for this many minutes after a deploy" },
        "maxIssuesPerRun": { "type": "integer", "minimum": 1, "default": 3, "description": "Cap on issues filed per watcher pass" }
      }
    },
    "viewports": {
      "type": "object",
      "properties": {
        "desktop": { "$ref": "#/definitions/viewport" },
        "mobile":  { "$ref": "#/definitions/viewport" },
        "tablet":  { "$ref": "#/definitions/viewport" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "viewport": {
      "type": "object",
      "properties": {
        "width":  { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["width", "height"]
    }
  }
}
