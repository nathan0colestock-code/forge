{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Build Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "autoDeploy": { "type": "boolean", "default": true, "description": "Auto-deploy to Fly.io at end of pipeline" },
    "wallClockMin": { "type": "integer", "minimum": 0, "default": 0, "description": "Wall-clock cap in minutes; 0 = no cap" },
    "designLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "default": 5 },
        "minVisualScore": { "type": "number", "minimum": 0, "maximum": 10, "default": 8, "description": "Soft target — exits the loop early when reached" },
        "floorVisualScore": { "type": "number", "minimum": 0, "maximum": 10, "default": 6, "description": "Hard floor — if cap is hit below this, build fails (no deploy)" }
      }
    },
    "qualityLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "default": 5 },
        "minVisualScore": { "type": "number", "minimum": 0, "maximum": 10, "default": 8 },
        "floorVisualScore": { "type": "number", "minimum": 0, "maximum": 10, "default": 7, "description": "Hard floor — below this, build fails before Phase 5" },
        "requireAllTestsPassing": { "type": "boolean", "default": true }
      }
    },
    "deployLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "viewports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": { "$ref": "#/definitions/viewport" },
        "mobile":  { "$ref": "#/definitions/viewport" },
        "tablet":  { "$ref": "#/definitions/viewport" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width":  { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["width", "height"]
    }
  }
}
